<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Snake Game</title>

    <style>
        body {
            margin: 0;
            background: #222;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        h1 {
            margin-bottom: 5px;
        }

        #score {
            font-size: 20px;
            margin-bottom: 15px;
        }

        canvas {
            background: #111;
            border: 3px solid white;
        }

        button {
            margin-top: 15px;
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <h1>🐍 Snake Game</h1>
    <div id="score">Score: 0</div>

    <canvas id="gameCanvas" width="400" height="400"></canvas>

    <br>

    <button onclick="restartGame()">Restart</button>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        const box = 20;

        let snake;
        let apple;
        let direction;
        let nextDirection;
        let score;
        let game;

        function startGame() {
            snake = [
                { x: 200, y: 200 },
                { x: 180, y: 200 },
                { x: 160, y: 200 }
            ];

            direction = "RIGHT";
            nextDirection = "RIGHT";
            score = 0;

            document.getElementById("score").textContent =
                "Score: " + score;

            createApple();

            clearInterval(game);
            game = setInterval(updateGame, 100);
        }

        function createApple() {
            apple = {
                x: Math.floor(Math.random() * 20) * box,
                y: Math.floor(Math.random() * 20) * box
            };

            // Make sure the apple doesn't appear inside the snake
            for (let part of snake) {
                if (part.x === apple.x && part.y === apple.y) {
                    createApple();
                    return;
                }
            }
        }

        function drawGame() {
            // Clear the canvas
            ctx.fillStyle = "#111";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw the snake
            for (let i = 0; i < snake.length; i++) {
                ctx.fillStyle = i === 0 ? "#00ff00" : "#00aa00";

                ctx.fillRect(
                    snake[i].x,
                    snake[i].y,
                    box,
                    box
                );
            }

            // Draw the apple
            ctx.fillStyle = "red";
            ctx.beginPath();
            ctx.arc(
                apple.x + box / 2,
                apple.y + box / 2,
                box / 2 - 2,
                0,
                Math.PI * 2
            );
            ctx.fill();
        }

        function updateGame() {
            direction = nextDirection;

            let head = {
                x: snake[0].x,
                y: snake[0].y
            };

            // Move the snake
            if (direction === "UP") {
                head.y -= box;
            }

            if (direction === "DOWN") {
                head.y += box;
            }

            if (direction === "LEFT") {
                head.x -= box;
            }

            if (direction === "RIGHT") {
                head.x += box;
            }

            // Check if snake hits the wall
            if (
                head.x < 0 ||
                head.x >= canvas.width ||
                head.y < 0 ||
                head.y >= canvas.height
            ) {
                gameOver();
                return;
            }

            // Check if snake hits itself
            for (let part of snake) {
                if (head.x === part.x && head.y === part.y) {
                    gameOver();
                    return;
                }
            }

            // Add new head
            snake.unshift(head);

            // Check if snake eats apple
            if (
                head.x === apple.x &&
                head.y === apple.y
            ) {
                score++;

                document.getElementById("score").textContent =
                    "Score: " + score;

                createApple();
            } else {
                // Remove the tail
                snake.pop();
            }

            drawGame();
        }

        function gameOver() {
            clearInterval(game);

            ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = "white";
            ctx.font = "35px Arial";
            ctx.textAlign = "center";

            ctx.fillText(
                "GAME OVER",
                canvas.width / 2,
                canvas.height / 2
            );

            ctx.font = "20px Arial";

            ctx.fillText(
                "Score: " + score,
                canvas.width / 2,
                canvas.height / 2 + 40
            );
        }

        function restartGame() {
            startGame();
            drawGame();
        }

        // Keyboard controls
        document.addEventListener("keydown", function(event) {

            // Arrow keys
            if (event.key === "ArrowUp" && direction !== "DOWN") {
                nextDirection = "UP";
            }

            if (event.key === "ArrowDown" && direction !== "UP") {
                nextDirection = "DOWN";
            }

            if (event.key === "ArrowLeft" && direction !== "RIGHT") {
                nextDirection = "LEFT";
            }

            if (event.key === "ArrowRight" && direction !== "LEFT") {
                nextDirection = "RIGHT";
            }

            // WASD
            if ((event.key === "w" || event.key === "W")
                && direction !== "DOWN") {
                nextDirection = "UP";
            }

            if ((event.key === "s" || event.key === "S")
                && direction !== "UP") {
                nextDirection = "DOWN";
            }

            if ((event.key === "a" || event.key === "A")
                && direction !== "RIGHT") {
                nextDirection = "LEFT";
            }

            if ((event.key === "d" || event.key === "D")
                && direction !== "LEFT") {
                nextDirection = "RIGHT";
            }
        });

        // Start the game
        startGame();
        drawGame();
    </script>

</body>
</html>
